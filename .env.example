# LLM (DeepSeek / any OpenAI-compatible endpoint)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_THINKING=disabled

# 高德地图 Web 服务 Key — https://console.amap.com 应用管理 → 创建应用 → 添加 Key(Web服务)
AMAP_KEY=

# 和风天气 Key — https://console.qweather.com 创建项目和应用
QWEATHER_KEY=
# 和风账号专属 API Host — console.qweather.com/setting 查看，形如 xxxxxx.re.qweatherapi.com
QWEATHER_HOST=

# Vercel Postgres 连接串（在 Vercel 控制台 Storage → Create Database → Postgres 后自动注入）
# 本地可用 `vercel env pull .env.local` 拉取
POSTGRES_URL=

# 会话签名密钥，生产环境务必设置为随机长字符串
AUTH_SECRET=change-me-to-a-long-random-string
